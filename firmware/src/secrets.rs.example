//! Credentials of this installation. Copy this file to `secrets.rs` (gitignored) and fill in
//! the values. Never commit the real file.
//!
//! Constants that a build does not use (for example the Wi-Fi ones in the simulator build) are
//! allowed to be unused.

#![allow(dead_code)]

/// SSID of the Wi-Fi network the device joins.
pub const WIFI_SSID: &str = "your-ssid";
/// WPA2 password of that Wi-Fi network.
pub const WIFI_PASSWORD: &str = "your-wifi-password";

/// User name for the OTA endpoints (HTTP Basic auth).
pub const OTA_USER: &str = "ota-user";
/// Password for the OTA endpoints (HTTP Basic auth).
pub const OTA_PASSWORD: &str = "ota-password";
