# Rust needs more stack than the C defaults.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Board: ESP32 PLC 14 (16 MB, dio @ 80 MHz as in the C++ image), same partition layout as the C++ firmware.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# New image must confirm itself, otherwise the bootloader rolls back on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# A hung app reboots instead of staying stuck; while unconfirmed that also triggers the rollback.
CONFIG_ESP_TASK_WDT_PANIC=y
